		{
			"name": "2.5. Получение счета пользователя (с ожиданием обработки события Kafka)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const maxRetries = 5;",
							"let retries = parseInt(pm.environment.get(\"retry_count\")) || 0;",
							"",
							"if (pm.response.code === 200) {",
							"    const jsonData = pm.response.json();",
							"    pm.environment.set(\"accountId\", jsonData.id);",
							"    pm.environment.set(\"retry_count\", 0);",
							"    pm.test(\"Создан аккаунт пользователя\", function () {",
							"        pm.expect(jsonData.id).to.be.a('string');",
							"    });",
							"} else if (retries < maxRetries) {",
							"    pm.environment.set(\"retry_count\", retries + 1);",
							"    pm.test(\"Ожидание событий Kafka... Повтор попытки \" + (retries + 1), function() {",
							"        pm.expect.fail(\"Аккаунт еще не создан, повтор...\");",
							"    });",
							"    setTimeout(() => {",
							"        pm.sendRequest(pm.request, (err, res) => {});",
							"    }, 1500);",
							"} else {",
							"    pm.test(\"Не удалось получить аккаунт пользователя после нескольких попыток\", function () {",
							"        pm.expect.fail(\"Аккаунт не было создан сервисом billing-service\");",
							"    });",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "X-User-Id",
						"value": "{{userId}}"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/billing/api/v1/accounts",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"billing",
						"api",
						"v1",
						"accounts"
					]
				}
			},
			"response": []
		},
