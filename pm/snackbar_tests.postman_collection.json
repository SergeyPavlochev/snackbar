		{
			"name": "5. Проверка баланса - остаток 500 руб",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const maxRetries = 5;",
							"let retries = parseInt(pm.environment.get(\"retry_count\")) || 0;",
							"",
							"if (pm.response.code === 200) {",
							"    const jsonData = pm.response.json();",
							"    if (jsonData.balance === \"500.00\") {",
							"        pm.test(\"Баланс счета корректно уменьшился на 500.00 руб\", function () {",
							"            pm.expect(jsonData.balance).to.eql(\"500.00\");",
							"        });",
							"        pm.environment.set(\"retry_count\", 0);",
							"    } else if (retries < maxRetries) {",
							"        pm.environment.set(\"retry_count\", retries + 1);",
							"        pm.test(\"Ожидание событий Kafka... Повтор попытки \" + (retries + 1), function() {",
							"            pm.expect.fail(\"Баланс счета еще не обновлен, повтор...\");",
							"        });",
							"        setTimeout(() => {",
							"            pm.sendRequest(pm.request, (err, res) => {});",
							"        }, 1500);",
							"    } else {",
							"        pm.test(\"Баланс счета не был обновлен после нескольких попыток\", function () {",
							"            pm.expect.fail(\"Ожидается 500.00 руб, но получено: \" + jsonData.balance);",
							"        });",
							"    }",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
